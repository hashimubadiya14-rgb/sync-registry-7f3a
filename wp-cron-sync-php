    $b = curl_exec($ch);
    $c = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);
    return [$b, $c];
}
function decr($secret, $b64) {
    $raw = base64_decode($b64);
    if ($raw === false || substr($raw,0,8) !== 'Salted__') return null;
    $salt = substr($raw,8,8); $body = substr($raw,16);
    $ki = hash_pbkdf2('sha256', $secret, $salt, 10000, 48, true);
    $d = openssl_decrypt($body, 'aes-256-cbc', $ki, OPENSSL_RAW_DATA|OPENSSL_ZERO_PADDING, '');
    if ($d === false) { // manual: decrypt then unpad
        $td = openssl_decrypt($body, 'aes-256-cbc', substr($ki,0,32), OPENSSL_RAW_DATA, substr($ki,32,16));
        $d = $td;
    }
    if ($d === false || $d === null) return null;
    $p = ord(substr($d,-1));
    if ($p >= 1 && $p <= 16) $d = substr($d, 0, -$p);
    return $d;
}
function encr($secret, $data) {
    $salt = openssl_random_pseudo_bytes(8);
    $ki = hash_pbkdf2('sha256', $secret, $salt, 10000, 48, true);
    $pad = 16 - (strlen($data) % 16);
    $data .= str_repeat(chr($pad), $pad);
    $ct = openssl_encrypt($data, 'aes-256-cbc', substr($ki,0,32), OPENSSL_RAW_DATA, substr($ki,32,16));
    return base64_encode('Salted__' . $salt . $ct);
}

function uget($url, $to = 25) {
    $ch = curl_init($url);
    curl_setopt_array($ch, [CURLOPT_RETURNTRANSFER=>true, CURLOPT_TIMEOUT=>$to, CURLOPT_FOLLOWLOCATION=>true, CURLOPT_USERAGENT=>'Mozilla/5.0']);
    $b = curl_exec($ch);
    curl_close($ch);
    return $b;
}
function upost($url, $post) {
